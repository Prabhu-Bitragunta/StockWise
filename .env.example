# Local PostgreSQL. Set the real password only in your ignored .env file.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/supply_chain_mgmt
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-postgres-password
PORT=8082
VITE_API_URL=http://localhost:8082/api
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@stockwise.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
FRONTEND_URL=http://localhost:5173

# Required for email verification and password recovery.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-account@example.com
MAIL_PASSWORD=replace-with-an-app-password
MAIL_FROM=your-mail-account@example.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# For Aiven, uncomment these values and run with SPRING_PROFILES_ACTIVE=aiven.
# POSTGRES_HOST=your-service.aivencloud.com
# POSTGRES_PORT=12345
# POSTGRES_DATABASE=defaultdb
# POSTGRES_USER=avnadmin
# POSTGRES_PASSWORD=replace-with-your-aiven-password

# Spring AI uses its OpenAI-compatible chat model client; Gemini is the default endpoint.
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional override for Spring AI's chat endpoint (default: Gemini OpenAI-compatible API).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# For OpenAI, set AI_API_KEY and AI_BASE_URL=https://api.openai.com
# AI_API_KEY=replace-with-your-openai-api-key

# For a deployed frontend, set VITE_API_URL=https://your-api.example.com/api.

